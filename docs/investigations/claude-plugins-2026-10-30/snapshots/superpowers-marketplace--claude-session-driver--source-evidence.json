  "config": {
    ".claude-plugin/plugin.json": "{\n  \"name\": \"claude-session-driver\",\n  \"description\": \"Launch, control, and monitor other Claude Code sessions as workers via tmux\",\n  \"version\": \"4.0.1\",\n  \"author\": {\n    \"name\": \"Jesse Vincent\",\n    \"email\": \"jesse@fsck.com\"\n  },\n  \"homepage\": \"https://github.com/obra/claude-session-driver\",\n  \"repository\": \"https://github.com/obra/claude-session-driver\",\n  \"license\": \"MIT\",\n  \"keywords\": [\"session-driver\", \"worker-sessions\", \"tmux\", \"orchestration\", \"multi-agent\"]\n}\n",
    "hooks/hooks.json": "{\n  \"hooks\": {\n    \"PreToolUse\": [{\n      \"matcher\": \"*\",\n      \"hooks\": [{\n        \"type\": \"command\",\n        \"command\": \"node \\\"${CLAUDE_PLUGIN_ROOT}/dist/emit-event.cjs\\\"\"\n      }]\n    }],\n    \"SessionStart\": [{\n      \"matcher\": \"*\",\n      \"hooks\": [{\n        \"type\": \"command\",\n        \"command\": \"node \\\"${CLAUDE_PLUGIN_ROOT}/dist/emit-event.cjs\\\"\"\n      }]\n    }],\n    \"Stop\": [{\n      \"matcher\": \"*\",\n      \"hooks\": [{\n        \"type\": \"command\",\n        \"command\": \"node \\\"${CLAUDE_PLUGIN_ROOT}/dist/emit-event.cjs\\\"\"\n      }]\n    }],\n    \"UserPromptSubmit\": [{\n      \"matcher\": \"*\",\n      \"hooks\": [{\n        \"type\": \"command\",\n        \"command\": \"node \\\"${CLAUDE_PLUGIN_ROOT}/dist/emit-event.cjs\\\"\"\n      }]\n    }],\n    \"SessionEnd\": [{\n      \"matcher\": \"*\",\n      \"hooks\": [{\n        \"type\": \"command\",\n        \"command\": \"node \\\"${CLAUDE_PLUGIN_ROOT}/dist/emit-event.cjs\\\"\"\n      }]\n    }]\n  }\n}\n"
  },
  "markdown_frontmatter": {
    "skills/driving-claude-code-sessions/SKILL.md": "\nname: driving-claude-code-sessions\ndescription: Use when acting as a project manager that delegates tasks to other coding-agent sessions (Claude Code, Codex, or Pi) - launch workers, assign them work, monitor progress, review their tool calls, and collect results\n"
  }
