+	tt.SetFocused(true)
+	tt.Press(100, 20)
+	if a.OwnsPrimaryPress(tt.rt.public) || !b.OwnsPrimaryPress(tt.rt.public) || receivedActivity(tt.rt).UpSerial != beforeUp {
+		t.Fatal("blur/new primary revived old pending or forged a public UpSerial")
+	}
+}
