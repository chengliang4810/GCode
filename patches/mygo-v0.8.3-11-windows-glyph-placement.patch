+package ui
+
+import (
+	"bytes"
+	"fmt"
+	"reflect"
+	"runtime"
+	"testing"
+	"unsafe"
+
+	"github.com/egoist/mygo/internal/text"
+)
+
+func glyphPlacementTestSupported() bool {
+	return runtime.GOOS == "windows" && (runtime.GOARCH == "amd64" || runtime.GOARCH == "arm64")
+}
+
+func TestGlyphPlacementRepaintLayoutAndRestoration(t *testing.T) {
+	if !glyphPlacementTestSupported() {
+		t.Skip("Windows ClearType candidate")
+	}
+	for _, scale := range []float32{1, 1.25, 2} {
+		t.Run(fmt.Sprint(scale), func(t *testing.T) {
+			policy := GlyphPlacementNative
+			apply := true
+			var current *node
+			tt := coreNewTester(func(c *context) {
+				coreBox(c).Fill().Background(RGB(39, 39, 42)).Children(func() {
+					current = coreText(c, "AV To Tab02.txt 中文 e\u0301").Key("run").Label("run").Font("Microsoft YaHei UI").FontSize(10.5).
+						FontWeight(400).FontFeatures("kern=0").FixedLineHeight(17).Absolute().Left(20.2).Top(10)
+					if apply {
+						WithGlyphPlacement(wrapElement(current), policy)
+					}
+					coreText(c, "unrelated").Label("sibling").Absolute().Left(20).Top(45)
+				})
+			}, 400, 90)
+			tt.SetScale(scale)
+			tt.Frame()
+			bounds, _ := tt.Find("run")
+			params, layout := current.textParams(0), current.tl
+			glyphs := append([]text.Glyph(nil), layout.Lines[0].Glyphs...)
+			native := bytes.Clone(tt.Image().Pix)
+			policy = GlyphPlacementWindowsClearTypeQuarter
+			tt.Frame()
+			quarter := bytes.Clone(tt.Image().Pix)
+			if current.resolvedText().placeGlyph == nil {
+				t.Fatal("public opt-in was not wired into actual text paint")
+			}
+			if current.textParams(0) != params || current.tl != layout || !reflect.DeepEqual(glyphs, current.tl.Lines[0].Glyphs) {
+				t.Fatal("paint-only policy changed text params, retained layout or glyph shapes/advances")
+			}
+			if after, _ := tt.Find("run"); after != bounds {
+				t.Fatalf("paint policy moved layout: before=%v after=%v", bounds, after)
+			}
+			if bytes.Equal(native, quarter) {
+				t.Fatal("test did not observe changed actual glyph placement/coverage")
+			}
+			policy = GlyphPlacementNative
+			tt.Frame()
+			if !bytes.Equal(native, tt.Image().Pix) || current.resolvedText().placeGlyph != nil {
+				t.Fatal("explicit Native did not restore exact original frame")
+			}
+			policy = GlyphPlacementWindowsClearTypeQuarter
+			tt.Frame()
+			apply = false
+			tt.Frame()
+			if !bytes.Equal(native, tt.Image().Pix) || current.resolvedText().placeGlyph != nil {
+				t.Fatal("rebuilt keyed node retained an omitted policy")
+			}
+		})
+	}
+}
+
+func TestGlyphPlacementInheritanceAndPerWindowIsolation(t *testing.T) {
+	var inherited, overridden, unknown, sibling *node
+	build := func(c *context) {
+		root := coreColumn(c)
+		WithGlyphPlacement(wrapElement(root), GlyphPlacementWindowsClearTypeQuarter)
+		root.Children(func() {
+			inherited = coreText(c, "inherited")
+			overridden = coreText(c, "native")
+			WithGlyphPlacement(wrapElement(overridden), GlyphPlacementNative)
+			unknown = coreText(c, "unknown")
+			WithGlyphPlacement(wrapElement(unknown), GlyphPlacement(255))
+		})
+		sibling = coreText(c, "outside")
+	}
+	a := coreNewTester(build, 200, 100)
+	a.Frame()
+	if glyphPlacementTestSupported() && inherited.resolvedText().placeGlyph == nil {
+		t.Fatal("descendant did not inherit the opt-in")
+	}
+	if overridden.resolvedText().placeGlyph != nil || unknown.resolvedText().placeGlyph != nil || sibling.resolvedText().placeGlyph != nil {
+		t.Fatal("native override or unrelated branch inherited the opt-in")
+	}
+	var other *node
+	b := coreNewTester(func(c *context) { other = coreText(c, "independent window") }, 200, 100)
+	b.Frame()
+	if other.resolvedText().placeGlyph != nil {
+		t.Fatal("policy leaked across windows")
+	}
+	a.Frame()
+	if glyphPlacementTestSupported() && inherited.resolvedText().placeGlyph == nil {
+		t.Fatal("other window reset the original opt-in")
+	}
+}
+
+func TestGlyphPlacementCheckedLifetimeAndZero(t *testing.T) {
+	if got := WithGlyphPlacement(Element{}, GlyphPlacementWindowsClearTypeQuarter); got.Valid() {
+		t.Fatal("absent element became valid")
+	}
+	var expired Element
+	tt := coreNewTester(func(c *context) { expired = wrapElement(coreText(c, "lifetime")) }, 100, 50)
+	tt.Frame()
+	defer func() {
+		if recover() == nil {
+			t.Fatal("expired checked Element did not diagnose use")
+		}
+	}()
+	WithGlyphPlacement(expired, GlyphPlacementWindowsClearTypeQuarter)
+}
+
+func TestGlyphPlacementBuildStateSizes(t *testing.T) {
+	t.Logf("node=%d textStyle=%d optionalFunctionWord=%d", unsafe.Sizeof(node{}), unsafe.Sizeof(textStyle{}), unsafe.Sizeof(glyphPlacementPaint(nil)))
+}
diff --git a/third_party/mygo/ui/glyph_placement_windows.go b/third_party/mygo/ui/glyph_placement_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..e16d4d6afae3afcabc36b9bb1a8698fe446ac19f
--- /dev/null
+++ b/third_party/mygo/ui/glyph_placement_windows.go
@@ -0,0 +1,111 @@
+//go:build windows && (amd64 || arm64)
+
+package ui
+
+import (
+	"math"
+
+	"github.com/egoist/mygo/internal/scene"
+	"github.com/egoist/mygo/internal/text"
+)
+
+func glyphPlacementFor(policy GlyphPlacement) glyphPlacementPaint {
+	if policy == GlyphPlacementWindowsClearTypeQuarter {
+		return paintQuarterText
+	}
+	return nil
+}
+
+// paintQuarterText runs only from the current kindText paint branch. Ghosts
+// pass their own current node as p.inline; no live-node closure is retained.
+func paintQuarterText(p *Painter, origin Rect) {
+	e := p.inline
+	if e == nil {
+		return
+	}
+	l := e.tl
+	ts := e.resolvedText()
+	var spans spanPaint
+	sp := e.paintSpans(&spans)
+	if l == nil || e.kind != kindText || e.spans != nil || e.first != nil || e.isInline() || e.contentSet || sp != nil {
+		// textLayout never dispatches this hook: unsupported paths paint once,
+		// with their original span colors/decorations and immediately return.
+		p.textLayout(l, origin.X, origin.Y, ts.color, ts, sp)
+		return
+	}
+	x, y, color := origin.X, origin.Y, ts.color
+	p.textBackgrounds(l, x, y, ts, sp)
+	// Content transitions also paint the old layout; only the current text
+	// carries its selection, in the same position, clip and opacity as its glyphs.
+	if e := p.inline; e != nil && e.tl == l {
+		if ed := e.st.editor; ed != nil && e.flags&flagSelectable != 0 && p.rt.textSelectionVisible(e.st) {
+			if a, b := ed.selection(); a != b {
+				for _, r := range l.Selection(a, b) {
+					p.Fill(Rect{x + r.X, y + r.Y, r.W, r.H}, ts.selectionColor(e.c.theme), 0)
+				}
+			}
+		}
+	}
+	sys := p.rt.text
+	s := p.scale
+	deco := decoration{underline: ts.underline, wavy: ts.wavy, strike: ts.strike, color: ts.decoColor, thick: ts.decoThick}
+	shade := text.ShadeOf(color.R, color.G, color.B)
+	start := int32(len(p.s.Glyphs))
+	// Inline transforms do not change while the text paints; look for them once.
+	moves := p.inlineTransforms()
+	clips := !p.transform.Set && !moves
+	var run *glyphRun
+	if sys.JoinsGlyphs() && !moves {
+		// The engine's, whose buffers each text reuses.
+		run = &p.rt.glyphRun
+		run.ids, run.pens, run.glyphs = run.ids[:0], run.pens[:0], run.glyphs[:0]
+	}
+	for li := range l.Lines {
+		line := &l.Lines[li]
+		if clips && (y+line.Y > p.clip.Y+p.clip.H || y+line.Y+line.Height < p.clip.Y) {
+			continue
+		}
+		baseline := sys.Baseline((y + line.Baseline) * s)
+		for _, g := range line.Glyphs {
+			pen := (x + g.X) * s
+			if g.Object || clips && (pen > (p.clip.X+p.clip.W)*s || pen+(g.Advance+g.Size)*s < p.clip.X*s) {
+				continue
+			}
+			ix := float32(math.Floor(float64(pen)))
+			glyphColor, glyphShade := color, shade
+			if sp != nil {
+				if glyphColor = sp.color(sp.at(g.Cluster), color); glyphColor != color {
+					glyphShade = text.ShadeOf(glyphColor.R, glyphColor.G, glyphColor.B)
+				}
+			}
+			gi := text.RasterGlyph(sys, g.Font, g.ID, s, pen, glyphShade, p.opaque && !moves, text.GlyphPlacementWindowsClearTypeQuarter)
+			if !gi.OK {
+				continue
+			}
+			glyphColor = glyphColor.Alpha(p.opacity)
+			sg := scene.Glyph{
+				X: ix + gi.Left, Y: baseline + gi.Top, W: float32(gi.W), H: float32(gi.H),
+				U: gi.X, V: gi.Y, UW: gi.W, VH: gi.H,
+				Transform: p.inlineTransform(g.Cluster).Pixels(s),
+				Color:     glyphColor.scene(), Wide: p.glyphWide(glyphColor), Colored: gi.Colored, Subpixel: gi.Subpixel, Thin: gi.Thin,
+			}
+			if run != nil {
+				run.add(p, g, gi, pen, sg, glyphShade, baseline)
+				continue
+			}
+			p.s.Glyphs = append(p.s.Glyphs, sg)
+		}
+		if run != nil {
+			run.flush(p, baseline)
+		}
+		if sp != nil {
+			sp.lines(p, l, li, x, y, color, deco)
+		}
+		if deco.underline || deco.strike {
+			p.decorations(l, li, 0, len(line.Glyphs), x, y, deco, color)
+		}
+	}
+	if end := int32(len(p.s.Glyphs)); end > start {
+		p.add(scene.Op{Kind: scene.OpGlyphs, Start: start, End: end})
+	}
+}
