diff --git a/third_party/mygo/ui/glyph_placement.go b/third_party/mygo/ui/glyph_placement.go
new file mode 100644
index 0000000000000000000000000000000000000000..0d40202a25d88049c5f20a62db4efcd335b8eb00
--- /dev/null
+++ b/third_party/mygo/ui/glyph_placement.go
@@ -0,0 +1,36 @@
+package ui
+
+// GlyphPlacement selects a paint-only horizontal glyph-placement policy.
+// It changes neither font selection, shaping, advances, nor layout geometry.
+type GlyphPlacement uint8
+
+const (
+	// GlyphPlacementNative retains the platform's normal glyph placement.
+	GlyphPlacementNative GlyphPlacement = iota
+	// GlyphPlacementWindowsClearTypeQuarter requests float32 quarter-device-
+	// pixel placement with half ties toward zero on Windows ClearType text.
+	// Negative coordinates retain signed-fraction/truncation extraction.
+	// Transparent/grayscale/aliased text and color-capable font faces keep
+	// native placement, as do all other platforms.
+	GlyphPlacementWindowsClearTypeQuarter
+)
+
+// An alias reuses the existing Draw/DrawOver function identity.
+// The Rect carries the current text origin in X/Y; W/H are unused.
+type glyphPlacementPaint = func(*Painter, Rect)
+
+// WithGlyphPlacement sets an inheritable paint-only policy for plain Text
+// leaves. Only the current kindText layout, without spans, inline children,
+// an inline parent or ContentTransition, uses the requested placement. Rich
+// text, font-only spans, inputs and Painter's custom text keep native painting.
+// Backgrounds, selection and decorations retain their normal paint order.
+// Native (the default), including unknown values, restores native placement.
+// This unpublished opt-in is narrower than the earlier per-glyph experiment.
+// This checked function adds no method to Element or private node.
+func WithGlyphPlacement(e Element, policy GlyphPlacement) Element {
+	if n := e.node(); n != nil {
+		n.ts.placeGlyph = glyphPlacementFor(policy)
+		n.ts.set |= setGlyphPlacement
+	}
+	return e
+}
diff --git a/third_party/mygo/ui/glyph_placement_default_control_test.go b/third_party/mygo/ui/glyph_placement_default_control_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..cfbd35f6ebde6fd7ab461ea2dc09fac0b478e387
--- /dev/null
+++ b/third_party/mygo/ui/glyph_placement_default_control_test.go
@@ -0,0 +1,56 @@
+package ui
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+	"unsafe"
+)
+
+// This byte-identical test is run on the sealed C4 default path and candidate.
+// It emits CPU/Tester control evidence only, never a visual-parity reference.
+func TestNativeDefaultPaintControl(t *testing.T) {
+	target := os.Getenv("QUARTER_DEFAULT_CONTROL_OUT")
+	if target == "" {
+		t.Skip("explicit fresh output directory is required")
+	}
+	if err := os.Mkdir(target, 0755); err != nil {
+		t.Fatal(err)
+	}
+	records := []map[string]any{}
+	for _, dark := range []bool{false, true} {
+		for _, scale := range []float32{1, 1.25, 2} {
+			var run *node
+			tt := coreNewTester(func(c *context) {
+				coreBox(c).Fill().Background(RGB(39, 39, 42)).Children(func() {
+					run = coreText(c, "AV To fi Tab02.txt 中文 e\u0301 🎉").Label("default").Font("Microsoft YaHei UI").FontSize(10.5).
+						FontWeight(400).FontFeatures("kern=0").Absolute().Left(20.2).Top(10)
+				})
+			}, 400, 90)
+			tt.SetDark(dark)
+			tt.SetScale(scale)
+			tt.Frame()
+			image := tt.Image()
+			data := image.Pix
+			hash := sha256.Sum256(data)
+			name := fmt.Sprintf("default-dark%v-scale%v.rgba", dark, scale)
+			if err := os.WriteFile(filepath.Join(target, name), data, 0644); err != nil {
+				t.Fatal(err)
+			}
+			bounds, _ := tt.Find("default")
+			records = append(records, map[string]any{"dark": dark, "scale": scale, "file": name, "sha256": hex.EncodeToString(hash[:]), "width": image.Rect.Dx(), "height": image.Rect.Dy(), "bytes": len(data), "bounds": bounds, "textParams": run.textParams(0)})
+		}
+	}
+	result := map[string]any{"nodeBytes": unsafe.Sizeof(node{}), "textStyleBytes": unsafe.Sizeof(textStyle{}), "records": records, "meaning": "default implementation consistency; not reference UI or visual parity"}
+	data, err := json.MarshalIndent(result, "", "  ")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(target, "result.json"), data, 0644); err != nil {
+		t.Fatal(err)
+	}
+}
diff --git a/third_party/mygo/ui/glyph_placement_layout_probe_test.go b/third_party/mygo/ui/glyph_placement_layout_probe_test.go
