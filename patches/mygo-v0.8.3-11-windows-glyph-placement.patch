+func quarterRunNonGlyphOps(tt *Tester) []scene.Op {
+	var ops []scene.Op
+	for _, op := range tt.h.last.Ops {
+		if op.Kind != scene.OpGlyphs {
+			ops = append(ops, op)
+		}
+	}
+	return ops
+}
