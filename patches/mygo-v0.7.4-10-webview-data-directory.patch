diff --git a/third_party/mygo/internal/windows/webview_data_test.go b/third_party/mygo/internal/windows/webview_data_test.go
new file mode 100644
index 0000000..b5a708e
--- /dev/null
+++ b/third_party/mygo/internal/windows/webview_data_test.go
@@ -0,0 +1,28 @@
+//go:build windows && (amd64 || arm64)
+
+package windows
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestWebViewUserDataDirectory(t *testing.T) {
+	local := t.TempDir()
+	t.Setenv("LOCALAPPDATA", local)
+	backend := &Backend{name: "GCode"}
+	if got := backend.webViewUserDataDirectory(); got != filepath.Join(local, "GCode", "WebView2") {
+		t.Fatalf("default profile = %q", got)
+	}
+	custom := filepath.Join(t.TempDir(), "运行目录", "browser")
+	backend.webViewDataDirectory = custom
+	if got := backend.webViewUserDataDirectory(); got != custom {
+		t.Fatalf("configured profile = %q, want %q", got, custom)
+	}
+	backend.webViewDataDirectory = ""
+	t.Setenv("LOCALAPPDATA", "")
+	if got := backend.webViewUserDataDirectory(); got != filepath.Join(os.TempDir(), "GCode", "WebView2") {
+		t.Fatalf("fallback profile = %q", got)
+	}
+}
diff --git a/third_party/mygo/webview_data.go b/third_party/mygo/webview_data.go
new file mode 100644
index 0000000..a5ad948
--- /dev/null
+++ b/third_party/mygo/webview_data.go
@@ -0,0 +1,33 @@
+package mygo
+
+import (
+	"errors"
+	"fmt"
+	"path/filepath"
+	"runtime"
+
+	"github.com/egoist/mygo/internal/platform"
+)
+
+// SetWebViewDataDirectory selects the persistent browser profile on Windows.
+// Call it before Run; an empty path keeps the platform's default. A non-empty
+// path must be absolute. Other platforms currently return an error matching
+// errors.ErrUnsupported.
+func (a *Application) SetWebViewDataDirectory(path string) error {
+	if path != "" {
+		if !filepath.IsAbs(path) {
+			return errors.New("mygo: webview data directory must be absolute")
+		}
+		if runtime.GOOS != "windows" {
+			return fmt.Errorf("mygo: custom webview data directory: %w", platform.ErrUnsupported)
+		}
+		path = filepath.Clean(path)
+	}
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.running {
+		return errors.New("mygo: webview data directory must be set before App.Run")
+	}
+	a.webViewDataDirectory = path
+	return nil
+}
