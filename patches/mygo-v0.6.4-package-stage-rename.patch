diff --git a/cmd/mygo/rename_stage_windows.go b/cmd/mygo/rename_stage_windows.go
new file mode 100644
--- /dev/null
+++ b/cmd/mygo/rename_stage_windows.go
@@ -0,0 +1,31 @@
+//go:build windows
+
+package main
+
+import (
+	"errors"
+	"os"
+	"syscall"
+	"time"
+)
+
+// renamePackageStage retries only the final commit of an already built package.
+// Windows can report ACCESS_DENIED for an open child of a directory. The same
+// code can mean a permanent ACL denial, so retries are limited and preserve the
+// last os.Rename error. The old destination is still managed by replacePath.
+func renamePackageStage(from, to string) error {
+	return retryPackageStageRename(func() error { return os.Rename(from, to) }, time.Sleep)
+}
+
+// Ten attempts schedule at most 900 ms of waiting, in addition to syscall and
+// scheduler time. No earlier replacePath phase or rollback is retried here.
+func retryPackageStageRename(rename func() error, pause func(time.Duration)) error {
+	for attempt := 1; ; attempt++ {
+		err := rename()
+		if err == nil || attempt == 10 ||
+			!errors.Is(err, syscall.Errno(5)) && !errors.Is(err, syscall.Errno(32)) {
+			return err
+		}
+		pause(100 * time.Millisecond)
+	}
+}
diff --git a/cmd/mygo/rename_stage_windows_integration_test.go b/cmd/mygo/rename_stage_windows_integration_test.go
new file mode 100644
--- /dev/null
+++ b/cmd/mygo/rename_stage_windows_integration_test.go
@@ -0,0 +1,141 @@
+//go:build windows && integration
+
+package main
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func holdPackageChild(t *testing.T, path string) func() {
+	t.Helper()
+	name, err := syscall.UTF16PtrFromString(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	handle, err := syscall.CreateFile(name, syscall.GENERIC_READ,
+		syscall.FILE_SHARE_READ|syscall.FILE_SHARE_WRITE, nil,
+		syscall.OPEN_EXISTING, syscall.FILE_ATTRIBUTE_NORMAL, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	closed := false
+	release := func() {
+		if !closed {
+			closed = true
+			if err := syscall.CloseHandle(handle); err != nil {
+				t.Errorf("close owned handle: %v", err)
+			}
+		}
+	}
+	t.Cleanup(release)
+	return release
+}
+
+func TestRetryPackageStageRenameOwnedChildReleased(t *testing.T) {
+	base := t.TempDir()
+	src, dst := filepath.Join(base, "stage"), filepath.Join(base, "final")
+	if err := os.Mkdir(src, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	child := filepath.Join(src, "payload")
+	if err := os.WriteFile(child, []byte("new package"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	release := holdPackageChild(t, child)
+	attempts, pauses := 0, 0
+	err := retryPackageStageRename(func() error {
+		attempts++
+		err := os.Rename(src, dst)
+		if attempts <= 2 && !errors.Is(err, syscall.Errno(5)) && !errors.Is(err, syscall.Errno(32)) {
+			t.Fatalf("owned handle must reject attempt %d with 5/32, got %v", attempts, err)
+		}
+		return err
+	}, func(d time.Duration) {
+		pauses++
+		if d != 100*time.Millisecond {
+			t.Fatalf("pause = %v, want 100ms", d)
+		}
+		// Delay CloseHandle until two actual rejected rename calls. Ordering is
+		// event-based; test success never depends on a wall-clock deadline.
+		if pauses == 2 {
+			release()
+		}
+	})
+	if err != nil || attempts != 3 || pauses != 2 {
+		t.Fatalf("rename = %v, attempts/pauses = %d/%d; want success after release", err, attempts, pauses)
+	}
+	if got, err := os.ReadFile(filepath.Join(dst, "payload")); err != nil || string(got) != "new package" {
+		t.Fatalf("committed payload = %q, %v", got, err)
+	}
+}
+
+func TestReplacePathOwnedChildHeldRestoresDestination(t *testing.T) {
+	base := t.TempDir()
+	src, dst := filepath.Join(base, "stage"), filepath.Join(base, "final")
+	for path, value := range map[string]string{src: "new package", dst: "old package"} {
+		if err := os.Mkdir(path, 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(path, "payload"), []byte(value), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	holdPackageChild(t, filepath.Join(src, "payload"))
+	err := replacePath(src, dst)
+	if !errors.Is(err, syscall.Errno(5)) && !errors.Is(err, syscall.Errno(32)) {
+		t.Fatalf("rename = %v, want original Windows in-use-eligible error", err)
+	}
+	var link *os.LinkError
+	if !errors.As(err, &link) || link.Old != src || link.New != dst {
+		t.Fatalf("error must come from final stage commit, got %v", err)
+	}
+	for path, want := range map[string]string{src: "new package", dst: "old package"} {
+		if got, readErr := os.ReadFile(filepath.Join(path, "payload")); readErr != nil || string(got) != want {
+			t.Fatalf("payload %s = %q, %v; want %q", path, got, readErr, want)
+		}
+	}
+	if old, globErr := filepath.Glob(filepath.Join(base, ".old-*")); globErr != nil || len(old) != 0 {
+		t.Fatalf("rollback left old destinations = %v, %v", old, globErr)
+	}
+}
+
+func TestRetryPackageStageRenameOwnedChildPermanentlyHeld(t *testing.T) {
+	base := t.TempDir()
+	src, dst := filepath.Join(base, "stage"), filepath.Join(base, "final")
+	if err := os.Mkdir(src, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(src, "payload"), []byte("new package"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	holdPackageChild(t, filepath.Join(src, "payload"))
+	attempts, pauses := 0, 0
+	err := retryPackageStageRename(func() error {
+		attempts++
+		err := os.Rename(src, dst)
+		if !errors.Is(err, syscall.Errno(5)) && !errors.Is(err, syscall.Errno(32)) {
+			t.Fatalf("native held-child rename %d = %v, want 5/32", attempts, err)
+		}
+		return err
+	}, func(d time.Duration) {
+		pauses++
+		if d != 100*time.Millisecond {
+			t.Fatalf("pause = %v, want 100ms", d)
+		}
+	})
+	if err == nil || attempts != 10 || pauses != 9 {
+		t.Fatalf("held child error %v; actual attempts/pauses = %d/%d, want 10/9", err, attempts, pauses)
+	}
+	t.Logf("permanently held child: %d actual rejected os.Rename calls, %d scheduled pauses; terminal error %v", attempts, pauses, err)
+	if got, err := os.ReadFile(filepath.Join(src, "payload")); err != nil || string(got) != "new package" {
+		t.Fatalf("source = %q, %v; want unchanged new package", got, err)
+	}
+	if _, err := os.Lstat(dst); !os.IsNotExist(err) {
+		t.Fatalf("destination must remain absent, stat = %v", err)
+	}
+}
diff --git a/cmd/mygo/rename_stage_windows_test.go b/cmd/mygo/rename_stage_windows_test.go
new file mode 100644
--- /dev/null
+++ b/cmd/mygo/rename_stage_windows_test.go
@@ -0,0 +1,67 @@
+//go:build windows
+
+package main
+
+import (
+	"errors"
+	"os"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func TestRetryPackageStageRename(t *testing.T) {
+	linkError := func(code syscall.Errno) error {
+		return &os.LinkError{Op: "rename", Old: "stage", New: "final", Err: code}
+	}
+	tests := []struct {
+		name         string
+		err          error
+		failures     int
+		wantAttempts int
+		wantPauses   int
+		wantError    bool
+	}{
+		{name: "first success", wantAttempts: 1},
+		{name: "access denied then released", err: linkError(5), failures: 2, wantAttempts: 3, wantPauses: 2},
+		{name: "sharing then released", err: linkError(32), failures: 1, wantAttempts: 2, wantPauses: 1},
+		{name: "permanent access denial bounded", err: linkError(5), failures: 20, wantAttempts: 10, wantPauses: 9, wantError: true},
+		{name: "permanent sharing bounded", err: linkError(32), failures: 20, wantAttempts: 10, wantPauses: 9, wantError: true},
+		{name: "missing source immediate", err: linkError(2), failures: 20, wantAttempts: 1, wantError: true},
+		{name: "missing parent immediate", err: linkError(3), failures: 20, wantAttempts: 1, wantError: true},
+		{name: "invalid data outside narrow allowlist", err: linkError(13), failures: 20, wantAttempts: 1, wantError: true},
+		{name: "lock violation outside narrow allowlist", err: linkError(33), failures: 20, wantAttempts: 1, wantError: true},
+		{name: "unclassified error immediate", err: errors.New("unclassified rename error"), failures: 20, wantAttempts: 1, wantError: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			attempts, pauses := 0, 0
+			var scheduled time.Duration
+			got := retryPackageStageRename(func() error {
+				attempts++
+				if attempts <= tt.failures {
+					return tt.err
+				}
+				return nil
+			}, func(d time.Duration) {
+				pauses++
+				scheduled += d
+				if d != 100*time.Millisecond {
+					t.Errorf("pause = %v, want 100ms", d)
+				}
+			})
+			if attempts != tt.wantAttempts || pauses != tt.wantPauses {
+				t.Fatalf("attempts/pauses = %d/%d, want %d/%d", attempts, pauses, tt.wantAttempts, tt.wantPauses)
+			}
+			if scheduled > 900*time.Millisecond {
+				t.Fatalf("scheduled wait = %v, exceeds 900ms budget", scheduled)
+			}
+			if tt.wantError && got != tt.err {
+				t.Fatalf("error = %v, want original error identity %v", got, tt.err)
+			}
+			if !tt.wantError && got != nil {
+				t.Fatalf("rename = %v, want success", got)
+			}
+		})
+	}
+}
