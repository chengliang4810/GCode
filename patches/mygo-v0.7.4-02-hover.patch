diff --git a/third_party/mygo/ui/hover.go b/third_party/mygo/ui/hover.go
new file mode 100644
index 0000000..c9a2669
--- /dev/null
+++ b/third_party/mygo/ui/hover.go
@@ -0,0 +1,64 @@
+package ui
+
+// OnHover calls fn when the pointer enters or leaves this element, including
+// when it disappears, is disabled, or a layout change moves it away. It follows
+// Hovered's press behavior. Calls run on the main thread after input or a
+// committed frame, never while the view is being constructed. A stable Key
+// keeps hover identity when rows reorder. The callback must not retain Element
+// or Context values from a build.
+func (e *node) OnHover(fn func(bool)) *node {
+	if e.hasState() {
+		e.flags |= flagHover
+		e.hoverFn = fn
+	}
+	return e
+}
+
+type hoverChange struct {
+	state *state
+	id    uint64
+	fn    func(bool)
+	over  bool
+}
+
+func (rt *engine) changeHover(s *state, over bool) {
+	if s.onHover == nil || s.hovered == over {
+		return
+	}
+	s.hovered = over
+	rt.hoverChanges = append(rt.hoverChanges, hoverChange{state: s, id: s.id, fn: s.onHover, over: over})
+}
+
+func (rt *engine) syncHoverCallbacks() {
+	for _, id := range rt.hover {
+		s := rt.states[id]
+		if s == nil {
+			continue
+		}
+		over := (rt.pointerIn || rt.pressed == s) && s.flags&flagDisabled == 0 && s.vw > 0 && s.vh > 0
+		if rt.pressed != nil && rt.pressed != s {
+			over = over && rt.contains(s, Rect{s.x, s.y, s.w, s.h}, rt.pointerX, rt.pointerY)
+		}
+		rt.changeHover(s, over)
+	}
+}
+
+func (rt *engine) publishHoverChanges() {
+	if rt.inFrame || len(rt.hoverChanges) == 0 {
+		return
+	}
+	changes := rt.hoverChanges
+	rt.hoverChanges = nil
+	for _, change := range changes {
+		if rt.closed {
+			break
+		}
+		// A pruned/reused state cannot deliver a stale enter. Its old leave
+		// still reaches the old callback so it can clear external highlighting.
+		if change.over && (rt.states[change.id] != change.state || !change.state.hovered) {
+			continue
+		}
+		change.fn(change.over)
+		rt.requestFrame()
+	}
+}
diff --git a/third_party/mygo/ui/hover_test.go b/third_party/mygo/ui/hover_test.go
new file mode 100644
index 0000000..4624c15
--- /dev/null
+++ b/third_party/mygo/ui/hover_test.go
@@ -0,0 +1,114 @@
+package ui
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/egoist/mygo/internal/platform"
+)
+
+func TestHoverCallbackEnterLeaveAndNoRebuildRepeat(t *testing.T) {
+	var got []bool
+	building := false
+	tt := NewTester(func(c *Context) {
+		building = true
+		defer func() { building = false }()
+		Box(c).Size(100, 100).OnHover(func(over bool) {
+			if building {
+				t.Fatal("hover callback ran during construction")
+			}
+			got = append(got, over)
+		})
+	}, 200, 200)
+	tt.Move(50, 50)
+	tt.Frame()
+	tt.Frame()
+	tt.Move(60, 60)
+	tt.Move(150, 150)
+	if !reflect.DeepEqual(got, []bool{true, false}) {
+		t.Fatalf("hover transitions = %v", got)
+	}
+}
+
+func TestHoverCallbackMatchesPressedHoverOnWindowLeave(t *testing.T) {
+	var got []bool
+	hovered := false
+	tt := NewTester(func(c *Context) {
+		button := Button(c, "Hold").Size(100, 100).OnHover(func(over bool) { got = append(got, over) })
+		hovered = button.Hovered()
+	}, 200, 200)
+	tt.Press(50, 50)
+	tt.rt.event(platform.SurfaceEvent{Kind: platform.PointerLeave})
+	tt.Frame()
+	if !hovered || !reflect.DeepEqual(got, []bool{true}) {
+		t.Fatalf("pressed hover = %v, callbacks %v", hovered, got)
+	}
+	tt.Release(150, 150)
+	if !reflect.DeepEqual(got, []bool{true, false}) {
+		t.Fatalf("release hover callbacks = %v", got)
+	}
+}
+
+func TestHoverCallbackDisappearanceAndStateReuse(t *testing.T) {
+	show, replacement := true, false
+	var got []string
+	tt := NewTester(func(c *Context) {
+		if show {
+			c.Key("original")
+			Box(c).Size(100, 100).OnHover(func(over bool) {
+				if over {
+					got = append(got, "enter")
+				} else {
+					got = append(got, "leave")
+				}
+			})
+		}
+		if replacement {
+			c.Key("replacement")
+			Box(c).Size(100, 100).OnHover(func(over bool) {
+				if over {
+					got = append(got, "replacement")
+				}
+			})
+		}
+	}, 200, 200)
+	tt.Move(50, 50)
+	show = false
+	tt.Frame()
+	replacement = true
+	tt.Frame()
+	tt.Frame()
+	if !reflect.DeepEqual(got, []string{"enter", "leave", "replacement"}) {
+		t.Fatalf("disappearance/reuse transitions = %v", got)
+	}
+}
+
+func TestHoverCallbackDisabledAndLatestCommittedCallback(t *testing.T) {
+	disabled := false
+	version := 1
+	var got []int
+	tt := NewTester(func(c *Context) {
+		v := version
+		Box(c).Size(100, 100).Disabled(disabled).OnHover(func(over bool) {
+			if over {
+				got = append(got, v)
+			} else {
+				got = append(got, -v)
+			}
+		})
+	}, 200, 200)
+	tt.Move(50, 50)
+	version = 2
+	tt.Frame()
+	tt.Move(150, 150)
+	disabled = true
+	tt.Frame()
+	tt.Move(50, 50)
+	disabled = false
+	tt.Frame()
+	disabled = true
+	tt.Frame()
+	if !reflect.DeepEqual(got, []int{1, -2, 2, -2}) {
+		t.Fatalf("disabled/latest callback transitions = %v", got)
+	}
+}
